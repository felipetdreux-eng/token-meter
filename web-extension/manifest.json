{
  "manifest_version": 3,
  "name": "Token Meter para claude.ai",
  "version": "0.1.0",
  "description": "Painel lateral com uso dos limites, contexto estimado da conversa e selo de modelo certo/errado para a tarefa.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Abrir Token Meter", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["lib.js", "content.js"], "run_at": "document_idle" }
  ]
}
